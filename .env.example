# Copy to .env and fill in locally. NEVER commit .env — it is gitignored.
# Every value below is intentionally empty: this file must never carry a real
# credential, and no test may depend on one.

# --- Dhan ---
# These three are all the auth bootstrap needs: it derives the TOTP locally with
# pyotp and exchanges client id + PIN + TOTP for a 24-hour access token, which it
# caches at data/cache/token_cache.json (gitignored, mode 0600).
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Optional manual override. Leave empty in normal operation — the bootstrap mints
# and caches a token for you. Set it only to work around an auth outage, or for a
# one-off run with a token generated on web.dhan.co. Ignored once expired.
DHAN_ACCESS_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths ---
# Absolute path to this repository. Every other path is derived from it, so the
# project can be moved or mounted elsewhere without code changes.
PROJECT_ROOT=

# --- Optional overrides (defaults shown in comments) ---
# ALGO_LOG_LEVEL=INFO
# ALGO_ENV=local
