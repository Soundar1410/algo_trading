# Copy to .env and fill in locally. NEVER commit .env — it is gitignored.
# Every value below is intentionally empty: this file must never carry a real
# credential, and no test may depend on one.

# --- Dhan ---
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paths ---
# Absolute path to this repository. Every other path is derived from it, so the
# project can be moved or mounted elsewhere without code changes.
PROJECT_ROOT=

# --- Optional overrides (defaults shown in comments) ---
# ALGO_LOG_LEVEL=INFO
# ALGO_ENV=local
