<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PROJECT_ROOT</key>
		<string>/Volumes/Trading/algo_trading</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.soundarraj.algotrading.autostart</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>while [ ! -x '/Volumes/Trading/algo_trading/.venv/bin/python' ]; do if [ "1$(/bin/date +%H%M)" -ge 11515 ]; then echo "autostart: /Volumes/Trading/algo_trading/.venv/bin/python did not appear before the 15:15 session deadline; is /Volumes/Trading mounted?" &gt;&amp;2; exit 75; fi; /bin/sleep 15; done; cd '/Volumes/Trading/algo_trading' || { echo "autostart: cannot enter /Volumes/Trading/algo_trading" &gt;&amp;2; exit 75; }; exec '/usr/bin/caffeinate' '-i' '-s' '/Volumes/Trading/algo_trading/.venv/bin/python' '-m' 'orchestration.auto_start'</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/Soundarraj/Library/Logs/algo_trading/launchd/autostart.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/Soundarraj/Library/Logs/algo_trading/launchd/autostart.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>0</integer>
			<key>Weekday</key>
